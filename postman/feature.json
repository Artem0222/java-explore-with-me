            "exec": [
              "\r\npm.test(\"Status code is 201 or 409\", function () {\r\n    pm.expect(pm.response.code).to.be.oneOf([201, 409]);\r\n});\r\n\r\nif (pm.response.code === 201) {\r\n    const json = pm.response.json();\r\n    pm.collectionVariables.set(\"userId\", json.id);\r\n    console.log(\"Создан новый пользователь с userId =\", json.id);\r\n} else if (pm.response.code === 409) {\r\n    console.log(\"Пользователь уже существует. Используется сохраненный ранее userId =\", pm.collectionVariables.get(\"userId\"));\r\n}\r\n"
            ]
          }
        }
      ],
