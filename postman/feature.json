            "exec": [
              "pm.test(\"Status 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response is array\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json).to.be.an('array');\r\n    pm.expect(json.length).to.be.greaterThan(0);\r\n});\r\n\r\npm.test(\"Contains our comment\", function () {\r\n    const json = pm.response.json();\r\n    const commentId = parseInt(pm.collectionVariables.get(\"commentId\"));\r\n    const found = json.find(c => c.id === commentId);\r\n    pm.expect(found).to.not.be.undefined;\r\n});"
