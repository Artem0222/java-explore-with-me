      "name": "Создать комментарий",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Save commentId\", function () {\r\n    const json = pm.response.json();\r\n    pm.collectionVariables.set(\"commentId\", json.id);\r\n});\r\n\r\npm.test(\"Comment has text\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json.text).to.eql(\"всё прошло супер!\");\r\n});\r\n\r\npm.test(\"Comment has author\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json.author).to.not.be.null;\r\n});\r\n\r\npm.test(\"Comment has event\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json.event).to.eql(parseInt(pm.collectionVariables.get(\"eventId\")));\r\n});\r\n\r\npm.test(\"Comment is not hidden\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json.hidden).to.be.false;\r\n});"
            ]
          }
        }
      ],
